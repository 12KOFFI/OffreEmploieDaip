<!DOCTYPE html>
<html lang="fr">
<head>
    <title>{% block title %}Tableau de bord{% endblock %} — DAIP Emploi</title>
    {% include 'partials/_head.html.twig' %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased bg-slate-50">

    {# ── Sidebar ─────────────────────────────────────────────────── #}
    <aside id="dashboard-sidebar" class="fixed inset-y-0 left-0 z-30 w-[260px] bg-navy-deep flex flex-col transition-transform duration-300 lg:translate-x-0 -translate-x-full">

        {# Logo #}
        <div class="h-[76px] flex items-center px-7 border-b border-white/10 shrink-0">
            <a href="{{ path('app_home') }}" class="flex items-center">
                <img src="{{ asset('img/imgi_2_logo.png') }}" alt="DAIP Emploi" class="h-10 w-auto">
            </a>
        </div>

        {# Navigation #}
        <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1">
            {% if is_granted('ROLE_DAIP') %}
                <a href="{{ path('daip_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'daip_dashboard' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 013.5 18v-2.25z"/></svg>
                    Tableau de bord
                </a>
                <a href="{{ path('daip_offres_index') }}" class="sidebar-link {{ app.request.get('_route') == 'daip_offres_index' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                    Registre des offres
                </a>
                <a href="{{ path('daip_entreprises_index') }}" class="sidebar-link {{ app.request.get('_route') == 'daip_entreprises_index' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    Registre des entreprises
                </a>
                <a href="{{ path('daip_profil_edit') }}" class="sidebar-link {{ app.request.get('_route') starts with 'daip_profil_' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                    Mon profil
                </a>
            {% endif %}

            {% if is_granted('ROLE_ENTREPRISE') %}
                <a href="{{ path('entreprise_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'entreprise_dashboard' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 013.5 18v-2.25z"/></svg>
                    Tableau de bord
                </a>
                <a href="{{ path('entreprise_offres_index') }}" class="sidebar-link {{ app.request.get('_route') == 'entreprise_offres_index' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                    Mes offres
                </a>
                <a href="{{ path('entreprise_offres_new') }}" class="sidebar-link {{ app.request.get('_route') == 'entreprise_offres_new' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Nouvelle offre
                </a>
                <a href="{{ path('entreprise_profil_edit') }}" class="sidebar-link {{ app.request.get('_route') == 'entreprise_profil_edit' ? 'active' : '' }}">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                    Mon profil
                </a>
            {% endif %}

            <div class="!mt-6 pt-4 border-t border-white/10">
                <a href="{{ path('app_home') }}" class="sidebar-link">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>
                    Retour au site
                </a>
            </div>
        </nav>

        {# User info + logout #}
        <div class="shrink-0 border-t border-white/10 px-5 py-4">
            <div class="text-xs text-white/50 truncate mb-0.5">
                {% if is_granted('ROLE_DAIP') %}Superviseur DAIP{% endif %}
                {% if is_granted('ROLE_ENTREPRISE') and app.user.entreprise %}{{ app.user.entreprise.nom }}{% endif %}
            </div>
            <div class="text-sm text-white/80 truncate mb-4">{{ app.user.email }}</div>
            <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 w-full px-3 py-2 rounded-xl text-sm font-medium text-white bg-red-500 hover:bg-red-600 transition-all duration-200 shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
                Déconnexion
            </a>
        </div>
    </aside>

    {# ── Mobile overlay ──────────────────────────────────────────── #}
    <div id="sidebar-overlay" class="fixed inset-0 z-20 bg-black/40 hidden lg:hidden" onclick="closeSidebar()"></div>

    {# ── Main content area ───────────────────────────────────────── #}
    <div class="lg:ml-[260px] min-h-screen flex flex-col">

        {# Top bar (mobile toggle + breadcrumb) #}
        <header class="sticky top-0 z-10 bg-white/80 backdrop-blur border-b border-slate-100 h-[60px] flex items-center px-6 gap-4">
            <button id="sidebar-toggle" class="lg:hidden text-slate-500 hover:text-navy" onclick="toggleSidebar()">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
            </button>
            <div class="text-sm text-slate-500 font-medium">
                {% block breadcrumb %}{% endblock %}
            </div>
        </header>

        {# Flash messages #}
        {% include 'partials/_flashes.html.twig' %}

        {# Page content #}
        <main class="flex-1 p-6 sm:p-8">
            {% block body %}{% endblock %}
        </main>

        {# Compact footer #}
        <footer class="px-6 py-4 text-xs text-slate-400 border-t border-slate-100">
            © {{ "now"|date("Y") }} DAIP Emploi — Registre d'offres d'emploi supervisé par la DAIP
        </footer>
    </div>

    {% include 'partials/_scripts.html.twig' %}
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('dashboard-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }
        function closeSidebar() {
            const sidebar = document.getElementById('dashboard-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>