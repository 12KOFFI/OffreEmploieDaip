{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="bg-slate-50 py-16 px-6">
    <div data-aos="fade-up" class="max-w-md mx-auto card p-10">
        <h1 class="text-2xl text-center mb-1.5">Mot de passe oublié</h1>
        <p class="text-center text-sm text-slate-500 mb-7">Entrez votre email pour recevoir un lien de réinitialisation.</p>

        {{ form_start(form, {attr: {id: 'forgot-form'}}) }}
            <label for="{{ form.email.vars.id }}" class="field-label">Adresse email</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                </span>
                {{ form_widget(form.email, {'attr': {'class': 'field-input pl-10', 'placeholder': 'vous@exemple.com'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <button type="submit" class="btn-orange w-full mt-6" id="forgot-submit">
                <span class="inline-flex items-center gap-2">
                    <svg id="forgot-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span id="forgot-text">Envoyer le lien</span>
                    <svg id="forgot-spinner" class="hidden animate-spin h-[17px] w-[17px] text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </span>
            </button>
        {{ form_end(form) }}

        <p class="text-center text-sm text-slate-500 mt-6">
            <a href="{{ path('app_login') }}" class="text-brand-indigo font-semibold hover:underline">← Retour à la connexion</a>
        </p>
    </div>
</div>

<script>
    var forgotForm = document.getElementById('forgot-form');
    if (forgotForm) {
        forgotForm.addEventListener('submit', function () {
            var button = document.getElementById('forgot-submit');
            var icon = document.getElementById('forgot-icon');
            var text = document.getElementById('forgot-text');
            var spinner = document.getElementById('forgot-spinner');

            button.disabled = true;
            button.classList.add('opacity-75', 'cursor-not-allowed');
            if (icon) icon.classList.add('hidden');
            if (text) text.textContent = 'Envoi en cours...';
            if (spinner) spinner.classList.remove('hidden');
        });
    }
</script>
{% endblock %}