{% extends 'dashboard_base.html.twig' %}

{% block title %}Mes offres{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('entreprise_dashboard') }}" class="hover:text-navy">Tableau de bord</a>
    <span class="mx-1.5">/</span>
    <span class="text-navy font-semibold">Mes offres</span>
{% endblock %}

{% block body %}
<div class="py-12 px-6 pb-24">
    <div class="max-w-5xl mx-auto">
        <div data-aos="fade-up" class="flex items-center justify-between flex-wrap gap-4 mb-8">
            <div>
                <h1 class="text-[26px]">Mes offres</h1>
                <p class="text-sm text-slate-500 mt-1">Gérez le cycle de vie de vos offres : brouillon, publication, retrait.</p>
            </div>
            <a href="{{ path('entreprise_offres_new') }}" class="btn-orange">+ Nouvelle offre</a>
        </div>

        {% if offres|length == 0 %}
            <div data-aos="fade-up" class="text-center py-16 px-6 bg-slate-50 rounded-2xl text-slate-500">
                <h3 class="text-navy font-semibold mb-2">Aucune offre pour l'instant</h3>
                <p>Créez votre première offre pour commencer à recruter.</p>
            </div>
        {% else %}
            <div data-aos="fade-up" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="rounded-2xl p-5 bg-brand-gradient text-white">
                    <span class="block font-display font-bold text-2xl">{{ total }}</span>
                    <span class="text-xs text-white/80">Total offres</span>
                </div>
                <div class="rounded-2xl p-5 bg-green-50 text-brand-green border border-4 border-slate-100">
                    <span class="block font-display font-bold text-2xl">{{ compteurs.publiee|default(0) }}</span>
                    <span class="text-xs opacity-70">Publiées</span>
                </div>
                <div class="rounded-2xl p-5 bg-slate-50 text-slate-600 border border-4 border-slate-100">
                    <span class="block font-display font-bold text-2xl">{{ compteurs.brouillon|default(0) }}</span>
                    <span class="text-xs opacity-70">Brouillons</span>
                </div>
                <div class="rounded-2xl p-5 bg-red-50 text-red-600 border border-4 border-slate-100">
                    <span class="block font-display font-bold text-2xl">{{ compteurs.retiree|default(0) }}</span>
                    <span class="text-xs opacity-70">Retirées</span>
                </div>
            </div>

            <div class="flex flex-col gap-3.5">
                {% for offre in offres %}
                    <a href="{{ path('app_offre_show', {id: offre.id}) }}" class="block no-underline">
                        <div data-aos="fade-up" data-aos-delay="{{ loop.index0 * 60 }}" class="card card-zoom p-5 px-6 flex items-center justify-between gap-5 flex-wrap cursor-pointer">
                            <div class="flex-1 min-w-[200px]">
                                <h3 class="text-[17px] font-semibold mb-1">{{ offre.titre }}</h3>
                                <div class="text-sm text-slate-500">
                                    {% if offre.villes|length > 0 %}{{ offre.villes|join(', ') }} · {% endif %}{{ offre.offreMetiers|length }} métier(s)
                                </div>
                            </div>
                            <span class="badge-{{ offre.statut.value }} inline-flex items-center">{{ offre.statut.label }}</span>
                            <div class="flex gap-2 flex-wrap items-center">
                                <a href="{{ path('entreprise_offres_edit', {id: offre.id}) }}" class="btn-ghost btn-sm hover:bg-indigo-50 hover:text-brand-indigo hover:border-brand-indigo/30">Modifier</a>



                                {% if offre.statut.value in ['brouillon', 'retiree'] %}
                                    <form method="post" action="{{ path('entreprise_offres_publier', {id: offre.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('changer-statut-' ~ offre.id) }}">
                                        <button type="submit" class="btn-orange btn-sm hover:opacity-90">Publier</button>
                                    </form>
                                {% elseif offre.statut.value == 'publiee' %}
                                    <form method="post" action="{{ path('entreprise_offres_retirer', {id: offre.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('changer-statut-' ~ offre.id) }}">
                                        <button type="submit" class="btn-ghost btn-sm hover:bg-orange-50 hover:text-orange-600 hover:border-orange-200">Retirer</button>
                                    </form>
                                {% endif %}

                                <form method="post" action="{{ path('entreprise_offres_delete', {id: offre.id}) }}" onsubmit="return confirm('Supprimer définitivement cette offre ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-offre-' ~ offre.id) }}">
                                    <button type="submit" class="btn-danger-ghost btn-sm hover:bg-red-50 hover:text-red-600 hover:border-red-200">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                <div class="flex items-center justify-center gap-2 mt-8">
                    {% if page > 1 %}
                        <a href="{{ path('entreprise_offres_index', {page: page - 1}) }}" class="btn-ghost btn-sm">← Précédent</a>
                    {% endif %}

                    {% for p in range(1, totalPages) %}
                        {% if p == page %}
                            <span class="px-4 py-2 rounded-full bg-navy text-white text-sm font-semibold">{{ p }}</span>
                        {% elseif p == 1 or p == totalPages or (p >= page - 1 and p <= page + 1) %}
                            <a href="{{ path('entreprise_offres_index', {page: p}) }}" class="px-4 py-2 rounded-full border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50">{{ p }}</a>
                        {% elseif p == page - 2 or p == page + 2 %}
                            <span class="text-slate-400">…</span>
                        {% endif %}
                    {% endfor %}

                    {% if page < totalPages %}
                        <a href="{{ path('entreprise_offres_index', {page: page + 1}) }}" class="btn-ghost btn-sm">Suivant →</a>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
