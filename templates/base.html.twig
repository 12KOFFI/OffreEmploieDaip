<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}DAIP Emploi{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased">
    <header class="sticky top-0 z-20 bg-white border-b border-slate-100">
        <div class="max-w-6xl mx-auto px-8 h-[76px] flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="font-display font-bold text-xl text-navy">
                DAIP <span class="text-brand-orange">Emploi</span>
            </a>
            <nav class="flex items-center gap-8">
                <a href="{{ path('app_home') }}#offres" class="hidden sm:inline text-sm font-medium text-slate-500 hover:text-navy transition-colors">Offres</a>
                <a href="{{ path('app_home') }}#comment-ca-marche" class="hidden sm:inline text-sm font-medium text-slate-500 hover:text-navy transition-colors">Comment ça marche</a>
                {% if app.user %}
                    <a href="{{ path('app_dashboard_redirect') }}" class="hidden sm:inline text-sm font-medium text-slate-500 hover:text-navy transition-colors">Mon espace</a>
                    <a href="{{ path('app_logout') }}" class="btn-ghost btn-sm">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="hidden sm:inline text-sm font-medium text-slate-500 hover:text-navy transition-colors">Connexion</a>
                    <a href="{{ path('app_login') }}" class="btn-orange btn-sm sm:text-sm sm:px-6 sm:py-3">Publier une offre</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main>
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-6xl mx-auto px-8 pt-6">
                    <div class="text-sm rounded-xl px-4 py-3 {{ label == 'error' ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-green-50 border border-green-200 text-brand-green' }}">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="bg-navy-deep text-white/65 pt-14 pb-7 mt-24">
        <div class="max-w-6xl mx-auto px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="col-span-2 md:col-span-1">
                    <div class="font-display font-bold text-lg text-white mb-3">DAIP <span class="text-brand-orange">Emploi</span></div>
                    <p class="text-sm max-w-xs">Le registre public des offres d'emploi des entreprises partenaires de la DAIP.</p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">Plateforme</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_home') }}#offres" class="hover:text-white">Consulter les offres</a></li>
                        <li><a href="{{ path('app_home') }}#comment-ca-marche" class="hover:text-white">Comment ça marche</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">Entreprises</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_register') }}" class="hover:text-white">Créer un compte</a></li>
                        <li><a href="{{ path('app_login') }}" class="hover:text-white">Connexion</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">DAIP</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_login') }}" class="hover:text-white">Accès superviseur</a></li>
                    </ul>
                </div>
            </div>
            <div class="mt-11 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-2 text-xs text-white/45">
                <span>© {{ "now"|date("Y") }} DAIP Emploi — Registre d'ofrres d'emploi supervisé par la DAIP</span>
                <span>Abidjan, Côte d'Ivoire</span>
            </div>
        </div>
    </footer>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init({ duration: 700, easing: 'ease-out-cubic', once: true, offset: 40 });</script>
    {% block javascripts %}{% endblock %}
</body>
</html>
