<!DOCTYPE html>
<html lang="fr">
<head>
    <title>{% block title %}DAIP Emploi{% endblock %}</title>
    {% include 'partials/_head.html.twig' %}
    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased">
    <header class="sticky top-0 z-20 bg-white border-b border-slate-100">
        <div class="max-w-6xl mx-auto px-8 h-[76px] flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="flex items-center">
                <img src="{{ asset('img/imgi_2_logo.png') }}" alt="DAIP Emploi" class="h-10 w-auto">
            </a>
            <nav class="hidden md:flex items-center gap-6">
                <a href="{{ path('app_home') }}" class="text-sm font-medium {{ app.request.get('_route') == 'app_home' ? 'text-navy font-semibold focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' : 'text-slate-500 hover:text-navy focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' }} transition-colors">Accueil</a>
                <a href="{{ path('app_offres_liste') }}" data-nav-offres data-target="#offres" class="text-sm font-medium {{ app.request.get('_route') == 'app_offres_liste' ? 'text-navy font-semibold focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' : 'text-slate-500 hover:text-navy focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' }} transition-colors">Offres</a>
                <a href="{{ path('app_home') }}#comment-ca-marche" class="text-sm font-medium text-slate-500 hover:text-navy transition-colors focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1">Comment ça marche</a>
                {% if app.user %}
                    <a href="{{ path('app_dashboard_redirect') }}" class="btn-orange btn-sm sm:text-sm sm:px-6 sm:py-3">Mon espace</a>
                    <a href="{{ path('app_logout') }}" class="bg-red-500 hover:bg-red-600 text-white transition-colors rounded-full font-semibold text-sm px-5 py-2.5 shadow-sm">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm font-medium {{ app.request.get('_route') == 'app_login' ? 'text-navy font-semibold focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' : 'text-slate-500 hover:text-navy focus:outline-none focus:ring-2 focus:ring-brand-indigo/40 focus:ring-offset-1' }} transition-colors">Connexion</a>
                    <a href="{{ path('app_login') }}" class="btn-orange btn-sm sm:text-sm sm:px-6 sm:py-3">Publier une offre</a>
                {% endif %}
            </nav>
            <button type="button" id="mobile-menu-toggle" onclick="toggleMobileMenu()" class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-slate-50 border border-slate-200/80 text-slate-700 hover:text-navy active:scale-95 transition-all shadow-sm" aria-label="Menu">
                <svg id="burger-icon-open" class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
                <svg id="burger-icon-close" class="w-5 h-5 hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white/95 backdrop-blur-lg shadow-xl">
            <div class="px-6 py-6 space-y-3">
                <a href="{{ path('app_home') }}" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-base font-medium transition-all {{ app.request.get('_route') == 'app_home' ? 'bg-slate-100/80 text-navy font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-navy' }}">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
                    Accueil
                </a>
                <a href="{{ path('app_offres_liste') }}" data-nav-offres data-target="#offres" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-base font-medium transition-all {{ app.request.get('_route') == 'app_offres_liste' ? 'bg-slate-100/80 text-navy font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-navy' }}">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 .621-.504 1.125-1.125 1.125H4.875A1.125 1.125 0 013.75 18.4v-4.25m16.5 0a2.25 2.25 0 00-2.25-2.25H5.625a2.25 2.25 0 00-2.25 2.25m16.5 0v-4.875c0-.621-.504-1.125-1.125-1.125H4.875A1.125 1.125 0 003.75 6.25v4.875m16.5 0H3.75"/></svg>
                    Offres d'emploi
                </a>
                <a href="{{ path('app_home') }}#comment-ca-marche" class="flex items-center gap-3 px-4 py-3 rounded-2xl text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-navy transition-all">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Comment ça marche
                </a>
                
                <div class="pt-3 border-t border-slate-100 flex flex-col gap-2.5">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard_redirect') }}" class="btn-orange w-full justify-center text-center py-3.5 shadow-sm">
                            Mon espace
                        </a>
                        <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 px-4 py-3 rounded-2xl text-base font-medium text-red-600 bg-red-50 hover:bg-red-100 transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
                            Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="flex items-center justify-center gap-2 px-4 py-3 rounded-2xl text-base font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all">
                            <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                            Se connecter
                        </a>
                        <a href="{{ path('app_login') }}" class="btn-orange w-full justify-center text-center py-3.5 shadow-sm">
                            Publier une offre
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <main>
        {% include 'partials/_flashes.html.twig' with { wrapper_class: 'max-w-6xl mx-auto px-8 pt-6' } %}

        {% block body %}{% endblock %}
    </main>

    <footer class="bg-navy-deep text-white/65 pt-14 pb-7 mt-24">
        <div class="max-w-6xl mx-auto px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="col-span-2 md:col-span-1">
                    <img src="{{ asset('img/imgi_2_logo.png') }}" alt="DAIP Emploi" class="h-10 w-auto mb-4">
                    <p class="text-sm max-w-xs">Le registre public des offres d'emploi des entreprises partenaires de la DAIP.</p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">Plateforme</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_offres_liste') }}" data-nav-offres data-target="#offres" class="hover:text-white">Consulter les offres</a></li>
                        <li><a href="{{ path('app_home') }}#comment-ca-marche" class="hover:text-white">Comment ça marche</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">Entreprises</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_register') }}" class="hover:text-white">Créer un compte</a></li>
                        <li><a href="{{ path('app_login') }}" class="hover:text-white">Connexion</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wide font-semibold text-white/90 mb-3">DAIP</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="{{ path('app_login') }}" class="hover:text-white">Accès superviseur</a></li>
                    </ul>
                </div>
            </div>
            <div class="mt-11 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between gap-2 text-xs text-white/45">
                <span>© {{ "now"|date("Y") }} DAIP Emploi — Registre d'offres d'emploi supervisé par la DAIP</span>
                <span>Abidjan, Côte d'Ivoire</span>
            </div>
        </div>
    </footer>

    {% include 'partials/_scripts.html.twig' %}
    {% block javascripts %}
        <script>
            window.toggleMobileMenu = function() {
                const mobileMenu = document.getElementById('mobile-menu');
                const iconOpen = document.getElementById('burger-icon-open');
                const iconClose = document.getElementById('burger-icon-close');
                if (mobileMenu) {
                    const isHidden = mobileMenu.classList.contains('hidden');
                    mobileMenu.classList.toggle('hidden');
                    if (iconOpen && iconClose) {
                        iconOpen.classList.toggle('hidden', isHidden);
                        iconClose.classList.toggle('hidden', !isHidden);
                    }
                }
            };

            document.addEventListener('click', function(e) {
                const mobileMenu = document.getElementById('mobile-menu');
                if (mobileMenu && !mobileMenu.classList.contains('hidden') && e.target.closest('#mobile-menu a')) {
                    window.toggleMobileMenu();
                }
            });
        </script>
    {% endblock %}
</body>
</html>