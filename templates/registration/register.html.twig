{% extends 'base.html.twig' %}

{% block title %}Inscription entreprise{% endblock %}

{% block body %}
<div class="bg-slate-50 py-16 px-6">
    <div data-aos="fade-up" class="max-w-lg mx-auto card p-10">
        <h1 class="text-2xl text-center mb-1.5">Créer un compte entreprise</h1>
        <p class="text-center text-sm text-slate-500 mb-7">Publiez vos offres en quelques minutes</p>

        {{ form_start(registrationForm) }}
            {# --- Email --- #}
            <label for="{{ registrationForm.email.vars.id }}" class="field-label">Email professionnel</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                </span>
                {{ form_widget(registrationForm.email, {attr: {class: 'field-input pl-10', placeholder: 'votre@entreprise.com'}}) }}
            </div>
            {{ form_errors(registrationForm.email) }}

            {# --- Mot de passe --- #}
            <label for="{{ registrationForm.plainPassword.first.vars.id }}" class="field-label">Mot de passe</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'field-input pl-10 pr-10', placeholder: '••••••••', id: 'password-field'}}) }}
                <button type="button" data-toggle-password="password-field" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <svg data-eye-open xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg data-eye-closed class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 1 12s4 8 11 8a9.26 9.26 0 0 0 5.39-1.61"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>
            {{ form_errors(registrationForm.plainPassword.first) }}

            {# --- Jauge de force du mot de passe --- #}
            <div class="mt-2.5">
                <div class="flex gap-1.5" id="strength-bars">
                    <span class="h-1.5 flex-1 rounded-full bg-slate-150 bg-slate-200 transition-colors duration-200" data-bar></span>
                    <span class="h-1.5 flex-1 rounded-full bg-slate-200 transition-colors duration-200" data-bar></span>
                    <span class="h-1.5 flex-1 rounded-full bg-slate-200 transition-colors duration-200" data-bar></span>
                    <span class="h-1.5 flex-1 rounded-full bg-slate-200 transition-colors duration-200" data-bar></span>
                </div>
                <p id="strength-label" class="text-xs text-slate-400 mt-1.5">Au moins 8 caractères, avec majuscule, chiffre et symbole recommandés.</p>
            </div>

            {# --- Confirmation --- #}
            <label for="{{ registrationForm.plainPassword.second.vars.id }}" class="field-label">Confirmer le mot de passe</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'field-input pl-10 pr-10', placeholder: '••••••••', id: 'password-confirm-field'}}) }}
                <button type="button" data-toggle-password="password-confirm-field" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <svg data-eye-open xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg data-eye-closed class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 1 12s4 8 11 8a9.26 9.26 0 0 0 5.39-1.61"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>
            {{ form_errors(registrationForm.plainPassword.second) }}

            {# --- Nom entreprise --- #}
            <label for="{{ registrationForm.nom.vars.id }}" class="field-label">Nom de l'entreprise</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
                </span>
                {{ form_widget(registrationForm.nom, {attr: {class: 'field-input pl-10', placeholder: 'TechCorp Abidjan'}}) }}
            </div>
            {{ form_errors(registrationForm.nom) }}

            {{ form_row(registrationForm.siret) }}
            {{ form_row(registrationForm.description) }}

            <button type="submit" class="btn-gradient w-full mt-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                Créer mon compte
            </button>
        {{ form_end(registrationForm) }}

        <p class="text-center text-sm text-slate-500 mt-6">
            Déjà un compte ? <a href="{{ path('app_login') }}" class="text-brand-indigo font-semibold hover:underline">Connectez-vous →</a>
        </p>
    </div>
</div>

<script>
    document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = document.getElementById(btn.getAttribute('data-toggle-password'));
            var isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.querySelector('[data-eye-open]').classList.toggle('hidden', isHidden);
            btn.querySelector('[data-eye-closed]').classList.toggle('hidden', !isHidden);
        });
    });

    (function () {
        var passwordField = document.getElementById('password-field');
        if (!passwordField) return;

        var bars = document.querySelectorAll('#strength-bars [data-bar]');
        var label = document.getElementById('strength-label');

        var levels = [
            { color: 'bg-red-400', text: 'Faible — ajoutez majuscules, chiffres et symboles.' },
            { color: 'bg-orange-400', text: 'Moyen — encore un peu court ou trop simple.' },
            { color: 'bg-yellow-400', text: 'Bon — presque parfait.' },
            { color: 'bg-brand-green', text: 'Excellent — mot de passe solide.' },
        ];

        function scorePassword(value) {
            var score = 0;
            if (value.length >= 8) score++;
            if (value.length >= 12) score++;
            if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score++;
            if (/[0-9]/.test(value)) score++;
            if (/[^A-Za-z0-9]/.test(value)) score++;
            return Math.min(score, 4);
        }

        passwordField.addEventListener('input', function () {
            var value = passwordField.value;

            bars.forEach(function (bar) { bar.className = 'h-1.5 flex-1 rounded-full bg-slate-200 transition-colors duration-200'; });

            if (value.length === 0) {
                label.textContent = 'Au moins 8 caractères, avec majuscule, chiffre et symbole recommandés.';
                label.className = 'text-xs text-slate-400 mt-1.5';
                return;
            }

            var score = scorePassword(value);
            var level = levels[Math.max(score - 1, 0)];

            for (var i = 0; i < score; i++) {
                bars[i].className = 'h-1.5 flex-1 rounded-full transition-colors duration-200 ' + level.color;
            }

            label.textContent = level.text;
            label.className = 'text-xs mt-1.5 font-medium ' + level.color.replace('bg-', 'text-');
        });
    })();
</script>
{% endblock %}
