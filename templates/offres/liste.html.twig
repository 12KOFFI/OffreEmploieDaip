{% extends 'base.html.twig' %}

{% block title %}Toutes les offres{% endblock %}

{% block body %}
<div class="bg-slate-50 py-12 px-6 pb-24">
    <div class="max-w-6xl mx-auto">
        <div data-aos="fade-up" class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <nav class="text-sm text-slate-500 mb-3 flex items-center gap-2">
                    <a href="{{ path('app_home') }}" class="text-slate-600 hover:text-brand-indigo font-medium transition-colors">Accueil</a>
                    <span class="text-slate-300">/</span>
                    <span class="text-navy font-semibold">Registre des offres</span>
                </nav>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-navy tracking-tight">Toutes les offres d'emploi</h1>
                <p class="text-base text-slate-500 mt-2">Découvrez les opportunités des entreprises enregistrées et supervisées par la DAIP.</p>
            </div>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white border border-slate-200/80 shadow-sm text-sm font-semibold text-slate-700 shrink-0 self-start md:self-auto">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>{{ total }} offre{{ total > 1 ? 's' : '' }} disponible{{ total > 1 ? 's' : '' }}</span>
            </div>
        </div>

        <div data-aos="fade-up">
            {% include 'offres/_filtres.html.twig' with {
                action_url: path('app_offres_liste'),
                filtres: filtres,
                metiers: metiers,
                typesContrat: typesContrat,
            } %}
        </div>

        <div id="offres-container">
            {% include 'offres/_liste.html.twig' with {
                offres: offres,
                filtres: filtres,
                filtresActifs: filtresActifs,
                metiers: metiers,
                typesContrat: typesContrat,
                total: total,
                page: page,
                totalPages: totalPages,
            } %}
        </div>
    </div>
</div>

<script>
(function () {
    var grid = document.getElementById('offres-grid');
    var pagination = document.getElementById('offres-pagination');
    var filtresActifsContainer = document.getElementById('filtres-actifs-container');
    var filterForm = document.querySelector('#offres-filters-form');

    function buildQueryString(extra) {
        var params = new URLSearchParams();
        var q = document.querySelector('[data-filter-q]');
        var ville = document.querySelector('[data-filter-ville]');
        var metier = document.querySelector('[data-filter-metier]');
        var typeContrat = document.querySelector('[data-filter-type-contrat]');

        if (q && q.value) params.set('q', q.value);
        if (ville && ville.value) params.set('ville', ville.value);
        if (metier && metier.value) params.set('metier', metier.value);
        if (typeContrat && typeContrat.value) params.set('typeContrat', typeContrat.value);
        if (extra && extra.page) params.set('page', extra.page);

        return params.toString();
    }

    function loadFragment(queryString, replaceUrl) {
        var url = '{{ path('app_offres_liste') }}' + (queryString ? '?' + queryString : '');

        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
        })
        .then(function (response) { return response.text(); })
        .then(function (html) {
            var container = document.getElementById('offres-container');
            if (container) {
                container.innerHTML = html;
            }
            
            // On peut aussi chercher s'il y a un composant filtres actifs dans le retour
            // Mais l'URL remplace tout. Pour plus de propreté, on recharge la page si ce conteneur doit bouger,
            // ou on laisse le JS s'en occuper, mais le plus simple pour le moment est de gérer le container.

            if (replaceUrl) {
                history.pushState(null, '', url);
            }
        })
        .catch(function () {
            if (replaceUrl) {
                window.location.href = url;
            }
        });
    }

    document.addEventListener('submit', function (e) {
        var form = e.target.closest('#offres-filters-form');
        if (!form) return;
        e.preventDefault();
        var qs = buildQueryString({ page: 1 });
        loadFragment(qs, true);
    });

    document.addEventListener('click', function (e) {
        var pageLink = e.target.closest('[data-page]');
        if (!pageLink) return;

        e.preventDefault();
        var page = pageLink.getAttribute('data-page');
        var qs = buildQueryString({ page: page });
        loadFragment(qs, true);
    });
})();
</script>
{% endblock %}
