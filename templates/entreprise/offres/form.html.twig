{% extends 'dashboard_base.html.twig' %}

{% block title %}{{ mode == 'creation' ? 'Nouvelle offre de recrutement' : "Modifier l'offre" }}{% endblock %}

{# ═══════════════════════════════════════════════════════════
   THÈME SYMFO CUSTOM — Gestion des erreurs
   ═══════════════════════════════════════════════════════════ #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="mt-2 space-y-1.5">
            {% for error in errors %}
                <p class="text-sm sm:text-xs font-medium text-red-600 flex items-center gap-2 bg-red-50 px-3 py-2.5 sm:px-2.5 sm:py-1.5 rounded-xl sm:rounded-lg border border-red-100">
                    <i class="fa-solid fa-circle-info text-red-500 shrink-0"></i>
                    <span>{{ error.message }}</span>
                </p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{# ═══════════════════════════════════════════════════════════
   THÈME SYMFO CUSTOM — Ligne Métier (Collection)
   ═══════════════════════════════════════════════════════════ #}
{% block _offre_offreMetiers_entry_widget %}
    <div class="offre-metier-item bg-white border border-slate-200 rounded-2xl p-0 relative shadow-sm hover:shadow-md hover:border-indigo-300 transition-all duration-200 mb-5 overflow-hidden" data-aos="fade-up">
        
        {# ==========================================
           MODE LECTURE (READ) — Carte Compacte
           ========================================== #}
        <div class="metier-read-mode hidden p-4 sm:p-5 cursor-pointer hover:bg-slate-50/80 active:bg-slate-100 transition-colors" onclick="toggleMetierEditMode(this.closest('.offre-metier-item'))">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <div class="min-w-0">
                    <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-briefcase text-indigo-600 shrink-0"></i>
                        <span class="read-metier-titre truncate">Nouveau Poste</span>
                        <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md ml-1 shrink-0">#<span class="metier-index">1</span></span>
                    </h3>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium text-slate-600">
                        <span title="Ville"><i class="fa-solid fa-location-dot text-slate-400 mr-1.5"></i><span class="read-ville">—</span></span>
                        <span title="Postes"><i class="fa-solid fa-users text-slate-400 mr-1.5"></i><span class="read-postes">—</span> poste(s)</span>
                        <span title="Contrat" class="read-contrat-wrapper hidden"><i class="fa-solid fa-file-contract text-slate-400 mr-1.5"></i><span class="read-contrat"></span></span>
                        <span title="Étude" class="read-etude-wrapper hidden"><i class="fa-solid fa-graduation-cap text-slate-400 mr-1.5"></i><span class="read-etude"></span></span>
                        <span title="Diplôme" class="read-diplome-wrapper hidden"><i class="fa-solid fa-certificate text-slate-400 mr-1.5"></i><span class="read-diplome"></span></span>
                        <span title="Expérience" class="read-exp-wrapper hidden"><i class="fa-solid fa-clock text-slate-400 mr-1.5"></i><span class="read-exp"></span> an(s)</span>
                        <span title="Salaire" class="read-salaire-wrapper hidden"><i class="fa-solid fa-money-bill-wave text-slate-400 mr-1.5"></i><span class="read-salaire"></span></span>
                    </div>
                </div>
                
                <div class="flex items-center gap-2 pt-1 sm:pt-0 shrink-0">
                    <button type="button" class="btn-edit-metier min-h-[44px] px-4 py-2.5 sm:px-3.5 sm:py-1.5 text-sm sm:text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 active:bg-slate-300 border border-slate-200 rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer flex-1 sm:flex-none">
                        <i class="fa-solid fa-pen text-slate-500"></i> <span>Modifier</span>
                    </button>
                    <button type="button" class="btn-remove-metier min-h-[44px] px-4 py-2.5 sm:px-3.5 sm:py-1.5 text-sm sm:text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 active:bg-red-200 border border-red-200 rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer flex-1 sm:flex-none" onclick="event.stopPropagation();">
                        <i class="fa-solid fa-trash-can"></i> <span>Supprimer</span>
                    </button>
                </div>
            </div>
        </div>

        {# ==========================================
           MODE ÉDITION (EDIT) — Formulaire
           ========================================== #}
        <div class="metier-edit-mode p-4 sm:p-7">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 pb-4 mb-5">
                <div class="flex items-center gap-2.5 flex-1 min-w-0">
                    <span class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-700 font-bold text-xs flex items-center justify-center border border-indigo-100 shrink-0">
                        #<span class="metier-index">1</span>
                    </span>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-base font-semibold text-slate-800 leading-tight flex items-center gap-2">
                            <i class="fa-solid fa-briefcase text-indigo-500 shrink-0"></i>
                            <span class="metier-title-display text-slate-800 truncate block">Définir ce poste</span>
                        </h3>
                    </div>
                </div>
                <button type="button" class="btn-remove-metier text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 active:bg-red-200 min-w-[40px] min-h-[40px] p-2 rounded-xl border border-red-200/60 transition-all cursor-pointer flex items-center justify-center shrink-0" title="Supprimer ce poste">
                    <i class="fa-solid fa-trash-can text-sm"></i>
                </button>
            </div>

            <div class="space-y-5">
                {# --- CHAMPS OBLIGATOIRES --- #}
                <div>
                    {{ form_label(form.metier, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                    <div class="flex items-start gap-2">
                        <div class="flex-1">
                            {{ form_widget(form.metier, {attr: {class: 'w-full px-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 metier-select bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                        </div>
                        <button type="button" class="btn-autre-metier shrink-0 px-4 py-3 sm:py-2.5 rounded-xl border border-indigo-200 text-indigo-600 hover:bg-indigo-50 active:bg-indigo-100 text-sm font-medium transition min-h-[48px] sm:min-h-0">Autre</button>
                    </div>
                    {{ form_errors(form.metier) }}
                    <div class="autre-metier-wrapper hidden mt-3">
                        {{ form_label(form.autreMetier) }}
                        {{ form_widget(form.autreMetier) }}
                        {{ form_errors(form.autreMetier) }}
                        <p class="mt-1.5 text-xs text-slate-500">Le métier sera vérifié et ajouté à la liste s'il n'existe pas déjà.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.nombrePostes, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-users text-sm"></i>
                            </div>
                            {{ form_widget(form.nombrePostes, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                        </div>
                        {{ form_errors(form.nombrePostes) }}
                    </div>
                    <div>
                        {{ form_label(form.ville, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-location-dot text-sm"></i>
                            </div>
                            {{ form_widget(form.ville, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                        </div>
                        {{ form_errors(form.ville) }}
                    </div>
                </div>

                {# --- CHAMPS OPTIONNELS (PROGRESSIVE DISCLOSURE) --- #}
                <div class="pt-2">
                    <button type="button" class="btn-toggle-advanced flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-800 active:text-indigo-900 transition-colors py-3 sm:py-2.5 px-4 sm:px-3.5 bg-indigo-50/60 hover:bg-indigo-50 active:bg-indigo-100 rounded-xl w-full justify-between cursor-pointer border border-indigo-100 min-h-[48px] sm:min-h-0">
                        <span><i class="fa-solid fa-sliders mr-2"></i>Préciser les exigences (Optionnel)</span>
                        <i class="fa-solid fa-chevron-down toggle-icon transition-transform"></i>
                    </button>
                    
                    <div class="advanced-fields hidden mt-5 space-y-5 sm:space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            <div>
                                {{ form_label(form.typeContrat, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-solid fa-file-contract text-sm"></i>
                                    </div>
                                    {{ form_widget(form.typeContrat, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                                </div>
                                {{ form_errors(form.typeContrat) }}
                            </div>
                            <div>
                                {{ form_label(form.niveauEtude, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-solid fa-graduation-cap text-sm"></i>
                                    </div>
                                    {{ form_widget(form.niveauEtude, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                                </div>
                                {{ form_errors(form.niveauEtude) }}
                            </div>
                            <div>
                                {{ form_label(form.diplome, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-solid fa-certificate text-sm"></i>
                                    </div>
                                    {{ form_widget(form.diplome, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                                </div>
                                {{ form_errors(form.diplome) }}
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(form.nbAnneesExperience, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-solid fa-clock text-sm"></i>
                                    </div>
                                    {{ form_widget(form.nbAnneesExperience, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                                </div>
                                {{ form_errors(form.nbAnneesExperience) }}
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-2">Fourchette salariale (FCFA)</label>
                                <div class="grid grid-cols-2 gap-3 relative">
                                    <div>
                                        <div class="relative">
                                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                                <i class="fa-solid fa-money-bill-wave text-sm"></i>
                                            </div>
                                            {{ form_widget(form.salaireMin, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0', placeholder: 'Min'}}) }}
                                        </div>
                                        {{ form_errors(form.salaireMin) }}
                                    </div>
                                    <div>
                                        {{ form_widget(form.salaireMax, {attr: {class: 'w-full px-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0', placeholder: 'Max'}}) }}
                                        {{ form_errors(form.salaireMax) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            {{ form_label(form.prerequis, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                            {{ form_widget(form.prerequis, {attr: {class: 'w-full px-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow', rows: 3}}) }}
                            {{ form_errors(form.prerequis) }}
                        </div>
                    </div>
                </div>

                <div class="pt-5 border-t border-slate-100 mt-5 flex justify-end">
                    <button type="button" class="btn-validate-metier w-full sm:w-auto px-5 py-3 sm:py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:bg-slate-700 text-white font-semibold text-sm transition-all flex items-center justify-center gap-2 shadow-sm cursor-pointer min-h-[48px] sm:min-h-0">
                        <i class="fa-solid fa-check text-green-400"></i> Réduire ce poste
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('entreprise_dashboard') }}" class="hover:text-slate-900 transition-colors">Tableau de bord</a>
    <span class="mx-1.5">/</span>
    <a href="{{ path('entreprise_offres_index') }}" class="hover:text-slate-900 transition-colors">Mes offres</a>
    <span class="mx-1.5">/</span>
    <span class="text-slate-900 font-semibold">{{ mode == 'creation' ? 'Nouvelle offre' : "Modifier l'offre" }}</span>
{% endblock %}

{% block body %}
{% form_theme form _self %}
<div class="bg-slate-50/80 py-6 sm:py-8 px-3 sm:px-6 pb-12 sm:pb-16">
    <div data-aos="fade-up" class="max-w-4xl mx-auto">

        {# ── En-tête principal de la page ───────────────────────── #}
        <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
            <div>
                <h1 class="text-xl sm:text-3xl font-bold text-slate-900 leading-tight">
                    {{ mode == 'creation' ? 'Créer une offre de recrutement' : 'Modifier votre offre' }}
                </h1>
                <p class="text-sm text-slate-500 mt-1">
                    Complétez les informations pour publier votre annonce.
                </p>
            </div>
            
            <div class="flex items-center gap-2 bg-white px-3.5 sm:px-4 py-2 rounded-xl border border-slate-200 shadow-sm text-xs font-semibold self-start">
                <span class="flex items-center gap-1.5 text-indigo-600">
                    <i class="fa-solid fa-file-lines"></i> Offre
                </span>
                <span class="text-slate-300">→</span>
                <span class="flex items-center gap-1.5 text-orange-500 font-bold">
                    <i class="fa-solid fa-briefcase"></i> Postes
                </span>
            </div>
        </div>

        {{ form_start(form, {attr: {id: 'offre-form', class: 'space-y-5 sm:space-y-6'}}) }}

        {# ═══════════════════════════════════════════════════════════
           ÉTAPE 1 — Informations générales de l'offre
           ═══════════════════════════════════════════════════════════ #}
        <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-8 shadow-sm">
            <div class="flex items-center gap-3 sm:gap-3.5 mb-5 sm:mb-6 pb-4 border-b border-slate-100">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-base sm:text-lg shadow-md shadow-indigo-200 flex-shrink-0">
                    1
                </div>
                <div>
                    <h2 class="text-base sm:text-lg font-bold text-slate-900">Informations de l'offre</h2>
                    <p class="text-xs text-slate-500 hidden sm:block">Titre global et contexte du recrutement.</p>
                </div>
            </div>

            <div class="space-y-5">
                <div>
                    {{ form_label(form.titre, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                    {{ form_widget(form.titre, {attr: {class: 'w-full px-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div>
                    {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                    {{ form_widget(form.description, {attr: {class: 'w-full px-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.dateExpiration, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-calendar-days text-sm"></i>
                            </div>
                            {{ form_widget(form.dateExpiration, {attr: {class: 'w-full pl-10 pr-3.5 py-3 sm:py-2.5 rounded-xl border border-slate-200 text-base sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white transition-shadow min-h-[48px] sm:min-h-0'}}) }}
                        </div>
                        {{ form_errors(form.dateExpiration) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.imageFile, null, {label_attr: {class: 'block text-sm font-semibold text-slate-700 mb-2'}}) }}
                    <div class="mt-1 flex items-center gap-4 p-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100/70 active:bg-slate-100 transition-colors min-h-[72px]">
                        <div class="w-11 h-11 sm:w-10 sm:h-10 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-400 flex-shrink-0">
                            <i class="fa-solid fa-image text-lg"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            {{ form_widget(form.imageFile, {attr: {class: 'block w-full text-sm sm:text-xs text-slate-500 file:mr-3 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm sm:file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer file:min-h-[40px]'}}) }}
                            <p class="text-xs text-slate-400 mt-1.5">JPG, PNG, WebP (max 2 Mo)</p>
                        </div>
                    </div>
                    {{ form_errors(form.imageFile) }}
                </div>
            </div>
        </div>

        {# ═══════════════════════════════════════════════════════════
           ÉTAPE 2 — Postes recherchés & Métiers
           ═══════════════════════════════════════════════════════════ #}
        <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-8 shadow-sm">
            <div class="flex items-center justify-between mb-5 sm:mb-6 pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3 sm:gap-3.5">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-orange-500 text-white flex items-center justify-center font-bold text-base sm:text-lg shadow-md shadow-orange-200 flex-shrink-0">
                        2
                    </div>
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-slate-900">Métiers recherchés</h2>
                        <p class="text-xs text-slate-500 hidden sm:block">Ajoutez les postes correspondant à cette offre.</p>
                    </div>
                </div>
            </div>

            {# Conteneur des blocs métiers #}
            <div id="offre-metiers-container" class="space-y-0" data-prototype="{{ form_widget(form.offreMetiers.vars.prototype)|e('html_attr') }}" data-index="{{ form.offreMetiers|length }}">
                {% for metierForm in form.offreMetiers %}
                    {{ form_widget(metierForm) }}
                {% endfor %}
            </div>

            {# Bouton "+ Ajouter un poste" #}
            <div class="mt-2">
                <button type="button" id="add-metier-btn" class="w-full py-4 sm:py-4 border-2 border-dashed border-indigo-200 hover:border-indigo-500 active:border-indigo-600 bg-indigo-50/50 hover:bg-indigo-50 active:bg-indigo-100 rounded-2xl text-sm font-bold text-indigo-600 transition-all flex flex-col sm:flex-row items-center justify-center gap-2 group cursor-pointer shadow-xs min-h-[56px]">
                    <span class="w-8 h-8 sm:w-7 sm:h-7 rounded-full bg-indigo-600 text-white flex items-center justify-center group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-plus text-xs"></i>
                    </span>
                    <span>Ajouter un métier</span>
                </button>
            </div>
        </div>

        {# ═══════════════════════════════════════════════════════════
           Résumé en direct & Actions de validation (En bas du formulaire)
           ═══════════════════════════════════════════════════════════ #}
        <div class="bg-white border border-slate-200 shadow-sm sm:shadow-lg rounded-2xl p-4 sm:p-6 w-full flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-2">
            
            {# Résumé — visible uniquement desktop #}
            <div class="hidden sm:block">
                <div class="flex items-center gap-2 text-sm font-bold text-slate-800 mb-1">
                    <i class="fa-solid fa-check text-green-500"></i> Résumé
                </div>
                <div class="text-xs font-medium text-slate-600 flex items-center gap-3">
                    <span class="bg-slate-100 px-2 py-1 rounded-md"><i class="fa-solid fa-briefcase mr-1 text-indigo-600"></i> <span id="summary-metiers-num">0</span></span>
                    <span class="bg-slate-100 px-2 py-1 rounded-md"><i class="fa-solid fa-users mr-1 text-orange-500"></i> <span id="summary-postes-num">0</span></span>
                    <span id="summary-villes" class="text-slate-500 truncate max-w-[200px]"></span>
                </div>
            </div>

            {# Boutons d'action #}
            <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                <a href="{{ path('entreprise_offres_index') }}" class="inline-flex items-center justify-center min-h-[52px] sm:min-h-0 px-5 py-3 text-sm font-medium text-slate-700 bg-white hover:bg-slate-100 active:bg-slate-200 border border-slate-300 rounded-xl transition-all shadow-xs cursor-pointer flex-1 sm:flex-none">
                    Annuler
                </a>

                <button type="submit" class="inline-flex items-center justify-center gap-2 min-h-[52px] sm:min-h-0 px-6 py-3 text-base sm:text-sm font-bold text-white bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 active:from-orange-700 active:to-amber-800 active:scale-[0.98] rounded-xl transition-all shadow-md shadow-orange-500/20 cursor-pointer flex-1 sm:flex-none">
                    <i class="fa-solid fa-floppy-disk"></i> <span>{{ mode == 'creation' ? 'Enregistrer en brouillon' : 'Enregistrer' }}</span>
                </button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
// Exposer la fonction toggle globalement pour le onclick
window.toggleMetierEditMode = null;

document.addEventListener('DOMContentLoaded', function () {
    var container = document.getElementById('offre-metiers-container');
    var addBtn = document.getElementById('add-metier-btn');
    var summaryMetiersNum = document.getElementById('summary-metiers-num');
    var summaryPostesNum = document.getElementById('summary-postes-num');
    var summaryVilles = document.getElementById('summary-villes');

    function initMetierSearch(root) {
        if (typeof TomSelect === 'undefined') return;
        (root || document).querySelectorAll('.metier-select').forEach(function(select) {
            if (select.tomselect) return;
            new TomSelect(select, {
                allowEmptyOption: true,
                create: false,
                maxOptions: 1000,
                placeholder: 'Rechercher un métier…',
                searchField: ['text'],
                sortField: { field: 'text', direction: 'asc' }
            });
        });
    }

    function toggleAutreMetier(item) {
        var select = item.querySelector('.metier-select');
        var wrapper = item.querySelector('.autre-metier-wrapper');
        var input = item.querySelector('.autre-metier-input');
        if (!select || !wrapper) return;
        if (input && input.value.trim()) item.dataset.autreMetier = '1';
        wrapper.classList.toggle('hidden', !item.dataset.autreMetier);
        var button = item.querySelector('.btn-autre-metier');
        if (button) button.textContent = item.dataset.autreMetier ? 'Choisir dans la liste' : 'Autre';
    }

    // === GESTION DE L'AFFICHAGE READ/EDIT ===
    window.toggleMetierEditMode = function(item, forceMode = null) {
        if (!item) return;
        var readMode = item.querySelector('.metier-read-mode');
        var editMode = item.querySelector('.metier-edit-mode');
        
        if (!readMode || !editMode) return;

        var isCurrentlyEdit = !editMode.classList.contains('hidden');
        
        if (forceMode === 'READ' || (forceMode === null && isCurrentlyEdit)) {
            syncEditToRead(item);
            toggleAutreMetier(item);
            editMode.classList.add('hidden');
            readMode.classList.remove('hidden');
        } 
        else if (forceMode === 'EDIT' || (forceMode === null && !isCurrentlyEdit)) {
            var allItems = container.querySelectorAll('.offre-metier-item');
            allItems.forEach(function(otherItem) {
                if (otherItem !== item) {
                    toggleMetierEditMode(otherItem, 'READ');
                }
            });
            
            readMode.classList.add('hidden');
            editMode.classList.remove('hidden');
        }
    };

    function syncEditToRead(item) {
        var select = item.querySelector('.metier-select');
        var titre = item.querySelector('.read-metier-titre');
        if (select && titre) {
            var selectedText = select.options[select.selectedIndex] ? select.options[select.selectedIndex].text : '';
            titre.textContent = (selectedText && selectedText !== 'Sélectionner un métier') ? selectedText : 'Poste non défini';
            
            var editTitre = item.querySelector('.metier-title-display');
            if (editTitre) editTitre.textContent = titre.textContent;
        }

        var villeInput = item.querySelector('[id$="_ville"]');
        var villeSpan = item.querySelector('.read-ville');
        if (villeInput && villeSpan) villeSpan.textContent = villeInput.value || '—';

        var postesInput = item.querySelector('[id$="_nombrePostes"]');
        var postesSpan = item.querySelector('.read-postes');
        if (postesInput && postesSpan) postesSpan.textContent = postesInput.value || '0';

        var contratInput = item.querySelector('[id$="_typeContrat"]');
        var contratSpan = item.querySelector('.read-contrat');
        var contratWrapper = item.querySelector('.read-contrat-wrapper');
        if (contratInput && contratSpan && contratWrapper) {
            var contratText = contratInput.options[contratInput.selectedIndex] ? contratInput.options[contratInput.selectedIndex].text : '';
            if (contratInput.value) {
                contratSpan.textContent = contratText;
                contratWrapper.classList.remove('hidden');
            } else {
                contratWrapper.classList.add('hidden');
            }
        }

        var etudeInput = item.querySelector('[id$="_niveauEtude"]');
        var etudeSpan = item.querySelector('.read-etude');
        var etudeWrapper = item.querySelector('.read-etude-wrapper');
        if (etudeInput && etudeSpan && etudeWrapper) {
            var etudeText = etudeInput.options[etudeInput.selectedIndex] ? etudeInput.options[etudeInput.selectedIndex].text : '';
            if (etudeInput.value) {
                etudeSpan.textContent = etudeText;
                etudeWrapper.classList.remove('hidden');
            } else {
                etudeWrapper.classList.add('hidden');
            }
        }

        var diplomeInput = item.querySelector('[id$="_diplome"]');
        var diplomeSpan = item.querySelector('.read-diplome');
        var diplomeWrapper = item.querySelector('.read-diplome-wrapper');
        if (diplomeInput && diplomeSpan && diplomeWrapper) {
            var diplomeText = diplomeInput.options[diplomeInput.selectedIndex] ? diplomeInput.options[diplomeInput.selectedIndex].text : '';
            if (diplomeInput.value) {
                diplomeSpan.textContent = diplomeText;
                diplomeWrapper.classList.remove('hidden');
            } else {
                diplomeWrapper.classList.add('hidden');
            }
        }

        var expInput = item.querySelector('[id$="_nbAnneesExperience"]');
        var expSpan = item.querySelector('.read-exp');
        var expWrapper = item.querySelector('.read-exp-wrapper');
        if (expInput && expSpan && expWrapper) {
            if (expInput.value) {
                expSpan.textContent = expInput.value;
                expWrapper.classList.remove('hidden');
            } else {
                expWrapper.classList.add('hidden');
            }
        }

        var salMinInput = item.querySelector('[id$="_salaireMin"]');
        var salMaxInput = item.querySelector('[id$="_salaireMax"]');
        var salSpan = item.querySelector('.read-salaire');
        var salWrapper = item.querySelector('.read-salaire-wrapper');
        if (salMinInput && salMaxInput && salSpan && salWrapper) {
            if (salMinInput.value || salMaxInput.value) {
                salSpan.textContent = (salMinInput.value || '0') + ' - ' + (salMaxInput.value || 'Max');
                salWrapper.classList.remove('hidden');
            } else {
                salWrapper.classList.add('hidden');
            }
        }
    }

    // === GESTION DE LA COLLECTION ===
    function getIndex() { return parseInt(container.dataset.index || '0', 10); }
    function setIndex(val) { container.dataset.index = val; }

    function updateMetierIndexesAndSummary() {
        var items = container.querySelectorAll('.offre-metier-item');
        var totalPostes = 0;
        var villes = [];

        items.forEach(function(item, i) {
            var indexSpans = item.querySelectorAll('.metier-index');
            indexSpans.forEach(function(s) { s.textContent = (i + 1); });

            var postesInput = item.querySelector('[id$="_nombrePostes"]');
            var villeInput = item.querySelector('[id$="_ville"]');
            if (postesInput && postesInput.value) totalPostes += parseInt(postesInput.value, 10) || 0;
            if (villeInput && villeInput.value && villeInput.value.trim() !== '') {
                var v = villeInput.value.trim();
                if (villes.indexOf(v) === -1) villes.push(v);
            }
            
            var removeBtns = item.querySelectorAll('.btn-remove-metier');
            removeBtns.forEach(function(btn) {
                btn.style.display = (items.length <= 1) ? 'none' : 'flex';
            });
            
            syncEditToRead(item);
            toggleAutreMetier(item);
        });

        var count = items.length;
        if (summaryMetiersNum) summaryMetiersNum.textContent = count;
        if (summaryPostesNum) summaryPostesNum.textContent = totalPostes;
        if (summaryVilles) summaryVilles.textContent = villes.length > 0 ? villes.join(', ') : '';
    }

    // Bouton Ajouter
    addBtn.addEventListener('click', function () {
        var index = getIndex();
        var prototype = container.dataset.prototype;
        var newForm = prototype.replace(/__name__/g, index);

        var tempDiv = document.createElement('div');
        tempDiv.innerHTML = newForm;
        var element = tempDiv.firstElementChild;
        if (!element) return;

        element.style.opacity = '0';
        element.style.transform = 'translateY(15px)';
        container.appendChild(element);
        initMetierSearch(element);
        setIndex(index + 1);

        requestAnimationFrame(function() {
            element.style.transition = 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
            element.style.opacity = '1';
            element.style.transform = 'translateY(0)';
        });

        toggleMetierEditMode(element, 'EDIT');
        toggleAutreMetier(element);
        updateMetierIndexesAndSummary();

        setTimeout(function() {
            element.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
    });

    // Délégation d'événements sur le conteneur
    container.addEventListener('click', function (e) {
        var removeBtn = e.target.closest('.btn-remove-metier');
        if (removeBtn) {
            var items = container.querySelectorAll('.offre-metier-item');
            if (items.length <= 1) return; 

            var itemToRemove = removeBtn.closest('.offre-metier-item');
            if (!itemToRemove) return;

            itemToRemove.style.transition = 'all 0.25s ease';
            itemToRemove.style.opacity = '0';
            itemToRemove.style.transform = 'scale(0.95)';

            setTimeout(function() {
                itemToRemove.remove();
                updateMetierIndexesAndSummary();
            }, 220);
            return;
        }

        var validateBtn = e.target.closest('.btn-validate-metier');
        if (validateBtn) {
            e.preventDefault();
            var item = validateBtn.closest('.offre-metier-item');
            toggleMetierEditMode(item, 'READ');
            return;
        }
        
        var toggleAdvBtn = e.target.closest('.btn-toggle-advanced');
        if (toggleAdvBtn) {
            var item = toggleAdvBtn.closest('.offre-metier-item');
            var advFields = item.querySelector('.advanced-fields');
            var icon = toggleAdvBtn.querySelector('.toggle-icon');
            if (advFields.classList.contains('hidden')) {
                advFields.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                advFields.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
            return;
        }
    });

    container.addEventListener('click', function (e) {
        var customButton = e.target.closest('.btn-autre-metier');
        if (!customButton) return;
        var item = customButton.closest('.offre-metier-item');
        var select = item.querySelector('.metier-select');
        item.dataset.autreMetier = item.dataset.autreMetier ? '' : '1';
        if (item.dataset.autreMetier && select) {
            if (select.tomselect) select.tomselect.clear();
            else select.value = '';
        }
        toggleAutreMetier(item);
    });

    container.addEventListener('change', function (e) {
        if (e.target && e.target.classList.contains('metier-select')) {
            var changedItem = e.target.closest('.offre-metier-item');
            if (e.target.value) changedItem.dataset.autreMetier = '';
            toggleAutreMetier(changedItem);
            updateMetierIndexesAndSummary();
        }
    });

    container.addEventListener('input', function (e) {
        updateMetierIndexesAndSummary();
    });

    // --- INITIALISATION ---
    initMetierSearch(container);
    var items = container.querySelectorAll('.offre-metier-item');
    if (items.length === 0) {
        addBtn.click();
    } else {
        items.forEach(function(item) {
            var hasErrors = item.querySelectorAll('.text-red-600').length > 0;
            toggleMetierEditMode(item, hasErrors ? 'EDIT' : 'READ');
        });
        var hasOneEdit = container.querySelector('.metier-edit-mode:not(.hidden)');
        if (!hasOneEdit && items.length > 0) {
            toggleMetierEditMode(items[0], 'EDIT');
        }
        updateMetierIndexesAndSummary();
    }
});
</script>
{% endblock %}