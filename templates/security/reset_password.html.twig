{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
<div class="bg-slate-50 py-16 px-6">
    <div data-aos="fade-up" class="max-w-md mx-auto card p-10">
        <h1 class="text-2xl text-center mb-1.5">Réinitialiser le mot de passe</h1>
        <p class="text-center text-sm text-slate-500 mb-7">Choisissez un nouveau mot de passe.</p>

        {{ form_start(form, {attr: {id: 'reset-form'}}) }}
            <label for="{{ form.plainPassword.first.vars.id }}" class="field-label">Nouveau mot de passe</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'field-input pl-10', 'placeholder': '••••••••'}}) }}
                {{ form_errors(form.plainPassword.first) }}
            </div>

            <label for="{{ form.plainPassword.second.vars.id }}" class="field-label mt-4">Confirmer le mot de passe</label>
            <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'field-input pl-10', 'placeholder': '••••••••'}}) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <button type="submit" class="btn-orange w-full mt-6" id="reset-submit">
                <span class="inline-flex items-center gap-2">
                    <svg id="reset-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                    <span id="reset-text">Réinitialiser</span>
                    <svg id="reset-spinner" class="hidden animate-spin h-[17px] w-[17px] text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </span>
            </button>
        {{ form_end(form) }}
    </div>
</div>

<script>
    var resetForm = document.getElementById('reset-form');
    if (resetForm) {
        resetForm.addEventListener('submit', function () {
            var button = document.getElementById('reset-submit');
            var icon = document.getElementById('reset-icon');
            var text = document.getElementById('reset-text');
            var spinner = document.getElementById('reset-spinner');

            button.disabled = true;
            button.classList.add('opacity-75', 'cursor-not-allowed');
            if (icon) icon.classList.add('hidden');
            if (text) text.textContent = 'Réinitialisation en cours...';
            if (spinner) spinner.classList.remove('hidden');
        });
    }
</script>
{% endblock %}