{% extends 'base.html.twig' %}

{% block title %}Mon profil entreprise{% endblock %}

{% block body %}
<div class="bg-slate-50 py-12 px-6 pb-24">
    <div data-aos="fade-up" class="max-w-2xl mx-auto card p-10 sm:p-11">
        <h1 class="text-2xl mb-1.5">Mon profil entreprise</h1>
        <p class="text-sm text-slate-500 mb-7">Ces informations sont visibles sur vos offres publiées.</p>

        {{ form_start(form) }}
            {{ form_row(form.nom) }}

            <div class="grid sm:grid-cols-2 gap-x-4">
                {{ form_row(form.siret) }}
                {{ form_row(form.siteWeb) }}
            </div>

            {{ form_row(form.logo) }}
            {{ form_row(form.description) }}

            <div class="flex gap-3 mt-8">
                <button type="submit" class="btn-orange">Enregistrer</button>
                <a href="{{ path('entreprise_offres_index') }}" class="btn-ghost">Retour à mes offres</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
