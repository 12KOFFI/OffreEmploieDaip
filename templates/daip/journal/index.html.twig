{% extends 'dashboard_base.html.twig' %}

{% block title %}Journal d'activité{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('daip_dashboard') }}" class="hover:text-navy">Tableau de bord</a>
    <span class="mx-1.5">/</span>
    <span class="text-navy font-semibold">Journal d'activité</span>
{% endblock %}

{% block body %}
<div class="py-12 px-6 pb-24">
    <div class="max-w-5xl mx-auto">
        <div data-aos="fade-up" class="mb-8">
            <h1 class="text-[26px]">Journal d'activité</h1>
            <p class="text-sm text-slate-500 mt-1">Historique des consultations et actions sur le registre.</p>
        </div>

        <div data-aos="fade-up" class="card overflow-hidden shadow-sm border border-slate-200/80 rounded-3xl bg-white">
            <div class="overflow-x-auto scrollbar-thin">
                <table class="w-full border-collapse min-w-[650px]">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-100">
                            <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3.5">Date</th>
                            <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3.5">Action</th>
                            <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3.5">Cible</th>
                            <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3.5">Utilisateur / IP</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr class="border-t border-slate-100 hover:bg-slate-50/80 transition-colors">
                                <td class="px-5 py-4 text-sm text-slate-500">{{ log.date|date('d/m/Y H:i') }}</td>
                                <td class="px-5 py-4 text-sm font-semibold text-navy">{{ log.action }}</td>
                                <td class="px-5 py-4 text-sm text-slate-600">{{ log.cibleType }} #{{ log.cibleId }}</td>
                                <td class="px-5 py-4 text-sm text-slate-600">{{ log.utilisateurEmail ?? '—' }} <span class="text-slate-400 text-xs ml-1">{{ log.adresseIp }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-center text-slate-500 py-12">Aucune activité enregistrée.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}