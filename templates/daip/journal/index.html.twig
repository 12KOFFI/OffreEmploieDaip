{% extends 'dashboard_base.html.twig' %}

{% block title %}Journal d'activité{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('daip_dashboard') }}" class="hover:text-navy">Tableau de bord</a>
    <span class="mx-1.5">/</span>
    <span class="text-navy font-semibold">Journal d'activité</span>
{% endblock %}

{% block body %}
<div class="py-12 px-6 pb-24">
    <div class="max-w-5xl mx-auto">
        <div data-aos="fade-up" class="mb-8">
            <h1 class="text-[26px]">Journal d'activité</h1>
            <p class="text-sm text-slate-500 mt-1">Historique des consultations et actions sur le registre.</p>
        </div>

        <div data-aos="fade-up" class="card overflow-hidden">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-slate-50">
                        <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3">Date</th>
                        <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3">Action</th>
                        <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3">Cible</th>
                        <th class="text-left text-xs uppercase tracking-wide text-slate-500 font-semibold px-5 py-3">Utilisateur / IP</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr class="border-t border-slate-100">
                            <td class="px-5 py-4 text-sm">{{ log.date|date('d/m/Y H:i') }}</td>
                            <td class="px-5 py-4 text-sm font-medium text-navy">{{ log.action }}</td>
                            <td class="px-5 py-4 text-sm">{{ log.cibleType }} #{{ log.cibleId }}</td>
                            <td class="px-5 py-4 text-sm">{{ log.utilisateurEmail ?? '—' }} <span class="text-slate-400">{{ log.adresseIp }}</span></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-slate-500 py-10">Aucune activité enregistrée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}