{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="{{ wrapper_class|default('mx-6 mt-4') }}">
            <div class="flash-notification text-sm rounded-xl px-4 py-3 {{ label == 'error' ? 'bg-red-50 border border-red-200 text-red-700' : 'bg-green-50 border border-green-200 text-brand-green' }}" data-flash-auto-hide>
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}